# OpsAgent 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== LLM 配置 ====================
# 选择 LLM 提供商 (推荐使用 LLM_CONFIG_* 方式配置)
LLM_PROVIDER=dashscope
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-plus
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120

# ==================== 服务器配置 ====================
OPSAGENT_HOST=0.0.0.0
OPSAGENT_PORT=8080

# ==================== 日志配置 ====================
OPSAGENT_LOG_LEVEL=info
OPSAGENT_LOG_FORMAT=json

# ==================== 钉钉配置 (可选) ====================
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# ==================== EIAM 身份平台接入 (可选) ====================
# OpsAgent 复用自建 EIAM 的会话：EIAM 登录后签发的会话令牌是一枚 HS256 JWT，
# OpsAgent 用同一把共享密钥本地验签（不走 OIDC、不连 Redis）。
# 配置 OPSAGENT_SESSION_ENCRYPTED_KEY 后，所有 /api/v1/* 请求都需携带有效的
# EIAM 会话令牌；留空则回退到 API_AUTH_TOKEN 静态令牌校验。
#
# 关键：此密钥必须与 EIAM 的 session.encrypted_key 逐字节一致，否则所有令牌验签失败。
OPSAGENT_SESSION_ENCRYPTED_KEY=
# EIAM 下发会话令牌的浏览器 Cookie 名（无 Authorization 头时作为令牌来源）。
OPSAGENT_SESSION_COOKIE_NAME=ecmdb-token-key
# 未登录浏览器跳转的 EIAM 登录地址（前端 401 时跳此地址，带 redirect 回跳）。
# 前端读取同名的 NEXT_PUBLIC_EIAM_LOGIN_URL。
OPSAGENT_EIAM_LOGIN_URL=/console/login

# ==================== 阿里云配置 (可选) ====================
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SLS_PROJECT=

# ==================== 阿里云 ARMS Prometheus 配置 (可选) ====================
# ARMS Prometheus Bearer Token (用于指标数据查询)
ARMS_PROMETHEUS_BEARER_TOKEN=

# ==================== Elastic 配置 (可选) ====================
ELASTIC_USERNAME=
ELASTIC_PASSWORD=

# ==================== 多云日志查询 (可选) ====================
# RCA 的日志维度支持“同时查多朵云再汇总”。配置哪朵云，该云就并入聚合：任一云
# 查询失败只记警告并跳过，其余云结果照常返回；全部云未配置则回退到 mock 日志。
# 每朵云各自把统一的查询“意图”（找错误日志 / 按服务过滤）翻译成自己的检索方言，
# 调用方无需关心 SLS / TLS 的语法差异。
#
# 阿里云 SLS（日志服务）：
SLS_ENDPOINT=
SLS_PROJECT=
SLS_LOGSTORE=
# 凭证留空则回退到 ALIYUN_ACCESS_KEY_ID / ALIYUN_ACCESS_KEY_SECRET
SLS_ACCESS_KEY_ID=
SLS_ACCESS_KEY_SECRET=
# 日志里标识“服务”的索引字段名（因部署而异，默认 service）
SLS_SERVICE_FIELD=
# 日志里标识“级别”的索引字段名（因部署而异，默认 level），用于把“只看错误日志”
# 的意图翻译成检索条件。注意：访问日志（nginx/tomcat）通常没有该字段，错误意图
# 应指向有 level 索引的应用日志；字段名不符会被云端拒绝（key not configured）。
SLS_LEVEL_FIELD=
#
# 火山引擎 TLS（日志服务）：
TLS_ENDPOINT=
# 签名所需的地域，如 cn-beijing
TLS_REGION=
# TLS 日志主题 ID（相当于 SLS 的 logstore），必填
TLS_TOPIC_ID=
# 凭证留空则回退到 VOLC_ACCESS_KEY_ID / VOLC_ACCESS_KEY_SECRET
TLS_ACCESS_KEY_ID=
TLS_ACCESS_KEY_SECRET=
TLS_SERVICE_FIELD=
# 同 SLS_LEVEL_FIELD（默认 level）；访问日志无此字段，错误意图应指向应用日志
TLS_LEVEL_FIELD=
