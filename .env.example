# OpsAgent 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== LLM 配置 ====================
# 选择 LLM 提供商 (推荐使用 LLM_CONFIG_* 方式配置)
LLM_PROVIDER=dashscope
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-plus
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120

# ==================== 服务器配置 ====================
OPSAGENT_HOST=0.0.0.0
OPSAGENT_PORT=8080

# ==================== 日志配置 ====================
OPSAGENT_LOG_LEVEL=info
OPSAGENT_LOG_FORMAT=json

# ==================== 钉钉配置 (可选) ====================
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# ==================== 阿里云配置 (可选) ====================
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SLS_PROJECT=

# ==================== 阿里云 ARMS Prometheus 配置 (可选) ====================
# ARMS Prometheus Bearer Token (用于指标数据查询)
ARMS_PROMETHEUS_BEARER_TOKEN=

# ==================== Elastic 配置 (可选) ====================
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
