# OpsAgent 配置文件
# 复制此文件为 config/settings.yaml 或 config/settings.local.yaml

# 运行环境
environment: development

# 服务器配置
server:
  host: "0.0.0.0"
  port: 8080
  read_timeout: 30
  write_timeout: 30

# ==================== LLM 配置 ====================
# 选择一个 LLM 提供商配置，注释掉其他的

# 方式 1: 直接配置 LLM (推荐)
llm:
  # 提供商: openai, dashscope, volcengine, deepseek, zhipu, moonshot, baichuan, minimax
  provider: dashscope

  # API 端点 (可选，使用预定义时可省略)
  base_url: https://dashscope.aliyuncs.com/compatible-mode/v1

  # API 密钥 (推荐使用环境变量 LLM_API_KEY)
  api_key: ${LLM_API_KEY}

  # 模型名称
  model: qwen-plus

  # 可选参数
  max_tokens: 4096
  temperature: 0.7
  timeout: 120

# ==================== 其他 LLM 提供商示例 ====================

# 火山引擎方舟
# llm:
#   provider: volcengine
#   base_url: https://ark.cn-beijing.volces.com/api/v3
#   api_key: ${LLM_API_KEY}
#   model: doubao-pro-32k  # 或推理接入点 ID: ep-xxxxx

# DeepSeek
# llm:
#   provider: deepseek
#   base_url: https://api.deepseek.com/v1
#   api_key: ${LLM_API_KEY}
#   model: deepseek-chat

# 智谱 AI (GLM)
# llm:
#   provider: zhipu
#   base_url: https://open.bigmodel.cn/api/paas/v4
#   api_key: ${LLM_API_KEY}
#   model: glm-4

# Moonshot (Kimi)
# llm:
#   provider: moonshot
#   base_url: https://api.moonshot.cn/v1
#   api_key: ${LLM_API_KEY}
#   model: moonshot-v1-8k

# 百川智能
# llm:
#   provider: baichuan
#   base_url: https://api.baichuan-ai.com/v1
#   api_key: ${LLM_API_KEY}
#   model: Baichuan2-Turbo

# MiniMax
# llm:
#   provider: minimax
#   base_url: https://api.minimax.chat/v1
#   api_key: ${LLM_API_KEY}
#   model: abab6.5s-chat

# OpenAI (国际)
# llm:
#   provider: openai
#   base_url: https://api.openai.com/v1
#   api_key: ${OPENAI_API_KEY}
#   model: gpt-3.5-turbo

# Azure OpenAI
# llm:
#   provider: azure
#   base_url: https://{resource}.openai.azure.com/openai/deployments/{deployment}
#   api_key: ${AZURE_OPENAI_API_KEY}
#   model: gpt-35-turbo

# ==================== 代理配置 ====================
# 如果需要使用代理

# http_proxy: http://127.0.0.1:7890
# https_proxy: http://127.0.0.1:7890

# ==================== Agent 配置 ====================
agent:
  # 模型名称 (如果不使用 llm 配置，使用此字段)
  model: qwen-plus

  # 对话轮数限制
  max_turns: 10

  # 超时时间(秒)
  timeout: 300

  # 最大并行 Agent 数
  max_parallel_agents: 5

# ==================== 数据源配置 ====================
datasources:
  # 阿里云 SLS (日志服务)
  aliyun_sls:
    endpoint: https://sls.aliyuncs.com
    access_key_id: ${ALIYUN_ACCESS_KEY_ID}
    access_key_secret: ${ALIYUN_ACCESS_KEY_SECRET}
    project: ${ALIYUN_SLS_PROJECT}

  # 阿里云 ARMS (应用监控)
  aliyun_arms:
    endpoint: https://arms.cn-hangzhou.aliyuncs.com
    access_key_id: ${ALIYUN_ACCESS_KEY_ID}
    access_key_secret: ${ALIYUN_ACCESS_KEY_SECRET}

  # Prometheus
  prometheus:
    endpoint: http://localhost:9090

  # Elasticsearch
  elasticsearch:
    endpoints:
      - http://localhost:9200
    username: ${ELASTIC_USERNAME}
    password: ${ELASTIC_PASSWORD}

# ==================== 可观测性配置 ====================
observability:
  # 日志级别: debug, info, warn, error
  log_level: info

  # 日志格式: json, text
  log_format: json

  # 是否启用链路追踪
  enable_tracing: false
  otlp_endpoint: ""

  # 是否启用指标收集
  enable_metrics: true
  metrics_port: 9090

# ==================== 安全配置 ====================
security:
  # 是否启用审计日志
  enable_audit_log: true
  audit_log_path: ./logs/audit.log

  # Vault 配置(可选)
  vault_addr: ""
  vault_token: ""
  vault_path: ""

# ==================== 钉钉配置 ====================
dingtalk:
  webhook_url: ${DINGTALK_WEBHOOK_URL}
  secret: ${DINGTALK_SECRET}

# ==================== 环境变量说明 ====================
#
# 必需:
#   LLM_API_KEY          - LLM API 密钥
#
# 可选:
#   ALIYUN_ACCESS_KEY_ID      - 阿里云 Access Key ID
#   ALIYUN_ACCESS_KEY_SECRET  - 阿里云 Access Key Secret
#   ALIYUN_SLS_PROJECT        - 阿里云 SLS 项目名
#   DINGTALK_WEBHOOK_URL      - 钉钉 Webhook URL
#   DINGTALK_SECRET           - 钉钉 Webhook 密钥
#
# 使用方式:
#   Windows: $env:VARIABLE_NAME = "value"
#   Linux/Mac: export VARIABLE_NAME="value"
