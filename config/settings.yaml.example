# OpsAgent 配置文件
# 复制此文件为 config/settings.yaml 或 config/settings.local.yaml

# 运行环境
environment: development

# 服务器配置
server:
  host: "0.0.0.0"
  port: 8080
  read_timeout: 30
  write_timeout: 30

# ==================== LLM 配置 ====================
# 选择一个 LLM 提供商配置，注释掉其他的

# 方式 1: 直接配置 LLM (推荐)
llm:
  # 提供商: openai, dashscope, volcengine, deepseek, zhipu, moonshot, baichuan, minimax
  provider: dashscope

  # API 端点 (可选，使用预定义时可省略)
  base_url: https://dashscope.aliyuncs.com/compatible-mode/v1

  # API 密钥 (推荐使用环境变量 LLM_API_KEY)
  api_key: ${LLM_API_KEY}

  # 模型名称
  model: qwen-plus

  # 可选参数
  max_tokens: 4096
  temperature: 0.7
  timeout: 120

# ==================== 其他 LLM 提供商示例 ====================

# 火山引擎方舟
# llm:
#   provider: volcengine
#   base_url: https://ark.cn-beijing.volces.com/api/v3
#   api_key: ${LLM_API_KEY}
#   model: doubao-pro-32k  # 或推理接入点 ID: ep-xxxxx

# DeepSeek
# llm:
#   provider: deepseek
#   base_url: https://api.deepseek.com/v1
#   api_key: ${LLM_API_KEY}
#   model: deepseek-chat

# 智谱 AI (GLM)
# llm:
#   provider: zhipu
#   base_url: https://open.bigmodel.cn/api/paas/v4
#   api_key: ${LLM_API_KEY}
#   model: glm-4

# Moonshot (Kimi)
# llm:
#   provider: moonshot
#   base_url: https://api.moonshot.cn/v1
#   api_key: ${LLM_API_KEY}
#   model: moonshot-v1-8k

# 百川智能
# llm:
#   provider: baichuan
#   base_url: https://api.baichuan-ai.com/v1
#   api_key: ${LLM_API_KEY}
#   model: Baichuan2-Turbo

# MiniMax
# llm:
#   provider: minimax
#   base_url: https://api.minimax.chat/v1
#   api_key: ${LLM_API_KEY}
#   model: abab6.5s-chat

# OpenAI (国际)
# llm:
#   provider: openai
#   base_url: https://api.openai.com/v1
#   api_key: ${OPENAI_API_KEY}
#   model: gpt-3.5-turbo

# Azure OpenAI
# llm:
#   provider: azure
#   base_url: https://{resource}.openai.azure.com/openai/deployments/{deployment}
#   api_key: ${AZURE_OPENAI_API_KEY}
#   model: gpt-35-turbo

# ==================== 代理配置 ====================
# 如果需要使用代理

# http_proxy: http://127.0.0.1:7890
# https_proxy: http://127.0.0.1:7890

# ==================== Agent 配置 ====================
agent:
  # 模型名称 (如果不使用 llm 配置，使用此字段)
  model: qwen-plus

  # 对话轮数限制
  max_turns: 10

  # 超时时间(秒)
  timeout: 300

  # 最大并行 Agent 数
  max_parallel_agents: 5

# ==================== 数据源配置 ====================
datasources:
  # 阿里云 SLS (日志服务)
  aliyun_sls:
    type: aliyun_sls
    endpoint: https://sls.aliyuncs.com
    access_key_id: ${ALIYUN_ACCESS_KEY_ID}
    access_key_secret: ${ALIYUN_ACCESS_KEY_SECRET}
    project: ${ALIYUN_SLS_PROJECT}
    logstore: ""
    # 日志中标识“服务”的索引字段名（因部署而异，默认 service），
    # 用于把查询意图 QueryIntent.ServiceName 翻译成 SLS 检索语法
    service_field: service
    # 日志中标识“级别”的索引字段名（因部署而异，默认 level），用于把“只看错误
    # 日志”的意图翻译成检索语法。访问日志（nginx/tomcat）通常无此字段，错误意图
    # 应指向有 level 索引的应用日志，否则云端会报 key not configured。
    level_field: level

  # 火山引擎 TLS (日志服务) —— 与 SLS 并列，RCA 日志维度会同时查询并汇总两朵云
  volcengine_tls:
    type: volcengine_tls
    endpoint: https://tls-cn-beijing.volces.com
    region: cn-beijing
    topic_id: ""
    access_key_id: ${VOLC_ACCESS_KEY_ID}
    access_key_secret: ${VOLC_ACCESS_KEY_SECRET}
    service_field: service
    level_field: level

  # 阿里云 ARMS (应用监控)
  aliyun_arms:
    endpoint: https://arms.cn-hangzhou.aliyuncs.com
    access_key_id: ${ALIYUN_ACCESS_KEY_ID}
    access_key_secret: ${ALIYUN_ACCESS_KEY_SECRET}

  # Prometheus
  prometheus:
    endpoint: http://localhost:9090

  # Elasticsearch
  elasticsearch:
    endpoints:
      - http://localhost:9200
    username: ${ELASTIC_USERNAME}
    password: ${ELASTIC_PASSWORD}

# ==================== 可观测性配置 ====================
observability:
  # 日志级别: debug, info, warn, error
  log_level: info

  # 日志格式: json, text
  log_format: json

  # 是否启用链路追踪
  enable_tracing: false
  otlp_endpoint: ""

  # 是否启用指标收集
  enable_metrics: true
  metrics_port: 9090

# ==================== 安全配置 ====================
security:
  # 是否启用审计日志
  enable_audit_log: true
  audit_log_path: ./logs/audit.log

  # Vault 配置(可选)
  vault_addr: ""
  vault_token: ""
  vault_path: ""

# ==================== 钉钉配置 ====================
dingtalk:
  webhook_url: ${DINGTALK_WEBHOOK_URL}
  secret: ${DINGTALK_SECRET}

# ==================== 告警模块（watch-alert）接入 ====================
# watch-alert 通过 WebHook/SREFlow 通知媒介把原生告警事件推送到
# POST /webhooks/watchalert，OpsAgent 将其转为事件并跑确定性 RCA。
# 告警按它自身的 tenantId 入库（watch-alert 与 EIAM 共用平台租户命名空间，
# 例如 "3" = 嘉立创 = EIAM tenant 3）；仅当告警缺失/非数字 tenantId 时，
# 才回退到下面的 tenant_id。
watchalert:
  # 兜底租户桶；仅在告警 tenantId 缺失/非数字时使用。留空/0 默认 1。
  tenant_id: 1

# ==================== EIAM 身份平台接入 ====================
# OpsAgent 复用自建 EIAM 的登录会话（不走 OIDC）：EIAM 登录后签发的会话令牌是
# 一枚 HS256 JWT，OpsAgent 用同一把共享密钥本地验签，并从中取 tenant_id 做多
# 租户隔离。鉴权契约：未携带/无效令牌 -> 401；已登录但未选租户(tenant_id=0)
# -> 403；租户只认令牌 claims，客户端传入的租户值一律丢弃。
eiam:
  # 与 EIAM 的 session.encrypted_key 逐字节一致的共享 HS256 密钥。
  # 留空则禁用 EIAM 鉴权，回退到 API_AUTH_TOKEN 静态令牌。
  session_key: ${OPSAGENT_SESSION_ENCRYPTED_KEY}
  # EIAM 下发会话令牌的浏览器 Cookie 名（无 Authorization 头时的令牌来源）。
  cookie_name: ecmdb-token-key
  # 未登录时前端跳转的 EIAM 登录地址。
  login_url: /console/login

# ==================== 环境变量说明 ====================
#
# 必需:
#   LLM_API_KEY          - LLM API 密钥
#
# 可选:
#   ALIYUN_ACCESS_KEY_ID      - 阿里云 Access Key ID
#   ALIYUN_ACCESS_KEY_SECRET  - 阿里云 Access Key Secret
#   ALIYUN_SLS_PROJECT        - 阿里云 SLS 项目名
#   DINGTALK_WEBHOOK_URL      - 钉钉 Webhook URL
#   DINGTALK_SECRET           - 钉钉 Webhook 密钥
#
# 使用方式:
#   Windows: $env:VARIABLE_NAME = "value"
#   Linux/Mac: export VARIABLE_NAME="value"
